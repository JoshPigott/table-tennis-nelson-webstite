---
const photo = '/table-tennis-nelson-action.webp';
const welcomePhoto = '/table-tennis-women-playing.webp';
const directions = 'https://www.google.com/maps/search/?api=1&query=Table+Tennis+Nelson%2C+142+Saxton+Road%2C+Stoke%2C+Nelson';
const facebook = 'https://www.facebook.com/TableTennisNelsonPage/';
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Come play table tennis in Nelson. All ages and abilities are welcome at Table Tennis Nelson, Saxton Field Stadium." />
    <title>Table Tennis Nelson | Come play</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Table Tennis Nelson home">Table Tennis <strong>Nelson</strong></a>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <figure>
          <img src={photo} alt="People playing table tennis together at Table Tennis Nelson" fetchpriority="high" />
        </figure>
        <div class="wrap hero-copy">
          <h1 id="hero-title">Play table tennis in Nelson.</h1>
          <p class="intro">Come along for a game, meet local players, and enjoy table tennis at Saxton Field. New players are welcome.</p>
          <div class="actions">
            <button class="button pending" type="button" disabled>View sessions</button>
          </div>
        </div>
      </section>

      <section class="visit wrap" id="visit" aria-labelledby="visit-title">
        <div>
          <h2 id="visit-title">Ready to give it a go?</h2>
          <p>You don’t need your own bat or ball. Just bring non-marking shoes and come ready to play.</p>
          <a class="button primary" href="https://www.sporty.co.nz/ttnelson/" target="_blank" rel="noopener noreferrer">See playing times <span aria-hidden="true">↗</span></a>
        </div>
        <img class="welcome-image" src={welcomePhoto} alt="Two women smiling as they play table tennis together" loading="lazy" />
      </section>

      <section class="location" id="find-us" aria-labelledby="location-title">
        <div class="wrap location-layout">
          <div class="location-info">
            <div>
              <h2 id="location-title">See you at the table.</h2>
              <p>Saxton Field Stadium<br />142 Saxton Road, Stoke, Nelson</p>
            </div>
            <a class="text-link" href={directions} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
          </div>
          <iframe class="map" title="Map showing Table Tennis Nelson at Saxton Field Stadium" src="https://www.google.com/maps?q=Table+Tennis+Nelson%2C+142+Saxton+Road%2C+Stoke%2C+Nelson%2C+New+Zealand&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} Table Tennis Nelson</span>
        <div>
          <a href="mailto:tabletennisnelson@outlook.com">Email us</a>
          <a href={facebook} target="_blank" rel="noopener noreferrer">Find us on Facebook <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --navy: #173b68;
    --blue: #0878bd;
    --blue-dark: #075d96;
    --paper: #ffffff;
    --pale-blue: #f0f6fb;
    --soft-blue: #dcebf6;
    --muted: #486078;
  }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: var(--paper); color: var(--navy); font-family: Arial, Helvetica, sans-serif; line-height: 1.55; }
  :global(a) { color: inherit; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 3px solid var(--blue-dark); outline-offset: 4px; }
  .wrap { width: min(100% - 3rem, 1200px); margin-inline: auto; }
  .header-inner, .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .site-header { border-bottom: 1px solid var(--soft-blue); background: var(--paper); }
  .header-inner { min-height: 84px; }
  .brand { display: flex; align-items: center; gap: .3rem; text-decoration: none; font-size: 1.1rem; font-weight: 600; letter-spacing: -.04em; white-space: nowrap; }
  .brand strong { font-weight: 600; }
  .footer-inner div { display: flex; gap: clamp(1rem, 3vw, 2.5rem); }
  footer a { text-decoration: none; font-size: .92rem; font-weight: 700; }
  footer a:hover { color: var(--soft-blue); }
  .text-link:hover { color: var(--blue-dark); }
  .hero { position: relative; display: flex; align-items: center; min-height: clamp(640px, calc(100svh - 84px), 900px); overflow: hidden; background: var(--navy); color: #fff; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12, 36, 65, .9), rgba(12, 36, 65, .65) 38%, rgba(12, 36, 65, .08) 78%); pointer-events: none; }
  .hero-copy { position: relative; z-index: 1; padding-block: 4rem; }
  .hero h1 { max-width: 9ch; }
  .hero .intro { color: #f0f6fb; }
  h1, h2, p { margin-top: 0; }
  h1, h2 { line-height: 1.05; letter-spacing: -.055em; }
  h1 { font-size: clamp(3.2rem, 6.4vw, 6.6rem); margin-bottom: 1.5rem; }
  h2 { font-size: clamp(2.5rem, 4.4vw, 4.5rem); margin-bottom: 1.4rem; }
  .intro { max-width: 31rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--muted); }
  .actions { display: flex; margin-top: 2.1rem; }
  .button { min-height: 56px; display: inline-flex; align-items: center; justify-content: center; gap: 1.2rem; border: 2px solid var(--blue); border-radius: 6px; padding: .95rem 1.55rem; font: inherit; font-weight: 800; text-decoration: none; box-shadow: 0 6px 16px rgba(8, 120, 189, .18); transition: transform .15s ease, background .15s ease, box-shadow .15s ease; }
  .button:not(:disabled):hover { transform: translateY(-2px); box-shadow: 0 9px 20px rgba(8, 120, 189, .24); }
  .primary, .pending { background: var(--blue); color: #fff; }
  .primary:hover { background: var(--blue-dark); }
  .button:disabled { cursor: not-allowed; }
  .hero figure { position: absolute; inset: 0; margin: 0; }
  .hero figure img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .visit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .78fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; padding-block: clamp(4rem, 7vw, 7rem); }
  .visit p { max-width: 540px; color: var(--muted); font-size: 1.13rem; }
  .visit .button { margin-top: 1rem; }
  .welcome-image { display: block; width: 100%; aspect-ratio: 3 / 2; border-radius: 6px; object-fit: cover; }
  .location { padding-block: clamp(4rem, 7vw, 6rem); background: var(--pale-blue); }
  .location h2 { margin-bottom: 1.2rem; }
  .location-layout { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .location-info p:last-of-type { margin-bottom: 1.5rem; color: var(--muted); }
  .text-link { padding-bottom: .3rem; font-weight: 800; text-decoration-thickness: 2px; text-underline-offset: 5px; white-space: nowrap; }
  .map { display: block; width: 100%; height: 360px; border: 0; border-radius: 6px; background: var(--soft-blue); }
  footer { background: var(--navy); color: #fff; }
  .footer-inner { min-height: 98px; font-size: .85rem; }
  @media (max-width: 780px) {
    .header-inner { min-height: 68px; }
    .hero { display: block; min-height: 0; background: var(--paper); color: var(--navy); }
    .hero::after { display: none; }
    .hero-copy { padding-block: 2.5rem 3rem; }
    .hero h1 { max-width: none; }
    .hero .intro { color: var(--muted); }
    .hero figure { position: static; }
    .hero figure img { height: auto; }
    .visit { grid-template-columns: 1fr; padding-block: 3.5rem; }
    .location { padding-block: 3.5rem; }
    .location-layout { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 600px) {
    .wrap { width: min(100% - 2rem, 1200px); }
    .header-inner { min-height: 64px; }
    .brand { font-size: 1.13rem; }
    .hero { --mobile-photo-height: min(125vw, 650px); }
    .hero figure { position: relative; height: var(--mobile-photo-height); }
    .hero figure img { height: 100%; object-position: right center; }
    .hero figure::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 20%, rgba(12, 36, 65, .45) 52%, rgba(12, 36, 65, .92) 100%); pointer-events: none; }
    .hero-copy { margin-top: calc(0px - var(--mobile-photo-height)); padding-block: 0 2rem; }
    .hero h1 { display: flex; align-items: flex-end; position: relative; min-height: var(--mobile-photo-height); margin: 0; padding-bottom: 3.5rem; color: #fff; font-size: clamp(3.4rem, 16vw, 6rem); line-height: .95; text-wrap: balance; text-shadow: 0 2px 14px rgba(4, 20, 38, .65); }
    .hero .intro { margin-top: 1.5rem; color: var(--navy); font-size: 1.15rem; }
    .hero .actions { margin-top: 1.5rem; }
    .hero .button, .visit .button { width: 100%; font-size: 1.05rem; }
    .visit { display: flex; flex-direction: column; align-items: stretch; gap: 1.4rem; padding-block: 1rem 3rem; }
    .visit .welcome-image { order: -1; width: calc(100% + 2rem); margin-inline: -1rem; aspect-ratio: 3 / 2; border-radius: 0; }
    .visit h2, .location h2 { font-size: clamp(2.25rem, 9vw, 3rem); }
    .visit h2 { margin-bottom: 1rem; }
    .visit p { margin: 0; color: var(--navy); font-size: 1.15rem; line-height: 1.5; }
    .location { padding-block: 3rem; }
    .location-info p { font-size: 1.1rem; }
    .map { height: 290px; }
    .footer-inner { align-items: flex-start; flex-direction: column; justify-content: center; gap: .8rem; padding-block: 1.5rem; }
    .footer-inner div { flex-wrap: wrap; gap: .75rem 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .button { transition: none; } }
</style>
