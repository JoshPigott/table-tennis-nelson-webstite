---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import photo from '../assets/home/table-tennis-nelson-action.webp';
import welcomePhoto from '../assets/home/table-tennis-women-playing.webp';

const directions = 'https://www.google.com/maps/search/?api=1&query=Table+Tennis+Nelson%2C+142+Saxton+Road%2C+Stoke%2C+Nelson';
import Container from '../components/Container.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<SiteLayout title="Table Tennis Nelson | Come play" description="Come play table tennis in Nelson. All ages and abilities are welcome at Table Tennis Nelson, Saxton Field Stadium.">
  <section aria-labelledby="hero-title" class="relative flex min-h-[clamp(640px,calc(100svh_-_84px),900px)] items-center overflow-hidden bg-navy text-white after:pointer-events-none after:absolute after:inset-0 after:bg-[linear-gradient(90deg,rgba(12,36,65,.9),rgba(12,36,65,.65)_38%,rgba(12,36,65,.08)_78%)] after:content-[''] max-[780px]:block max-[780px]:min-h-0 max-[780px]:bg-paper max-[780px]:text-navy max-[780px]:after:hidden max-[600px]:[--mobile-photo-height:min(125vw,650px)]">
    <figure class="absolute inset-0 m-0 max-[780px]:static max-[600px]:relative max-[600px]:h-(--mobile-photo-height) max-[600px]:after:pointer-events-none max-[600px]:after:absolute max-[600px]:after:inset-0 max-[600px]:after:bg-[linear-gradient(to_bottom,transparent_20%,rgba(12,36,65,.45)_52%,rgba(12,36,65,.92)_100%)] max-[600px]:after:content-['']">
      <Image class="block h-full w-full object-cover object-center max-[780px]:h-auto max-[600px]:h-full max-[600px]:object-right" src={photo} alt="People playing table tennis together at Table Tennis Nelson" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    </figure>
    <Container class="relative z-1 py-16 max-[780px]:pt-10 max-[780px]:pb-12 max-[600px]:-mt-(--mobile-photo-height) max-[600px]:pt-0 max-[600px]:pb-8">
      <h1 id="hero-title" class="mt-0 mb-6 max-w-[9ch] text-[clamp(3.2rem,6.4vw,6.6rem)] font-bold leading-[1.05] tracking-[-.055em] max-[780px]:max-w-none max-[600px]:relative max-[600px]:m-0 max-[600px]:flex max-[600px]:min-h-(--mobile-photo-height) max-[600px]:items-end max-[600px]:pb-14 max-[600px]:text-[clamp(3.4rem,16vw,6rem)] max-[600px]:leading-[.95] max-[600px]:text-balance max-[600px]:text-white max-[600px]:[text-shadow:0_2px_14px_rgba(4,20,38,.65)]">Play table tennis in Nelson.</h1>
      <p class="mt-0 mb-4 max-w-[31rem] text-[clamp(1.1rem,1.6vw,1.3rem)] text-pale-blue max-[780px]:text-muted max-[600px]:mt-6 max-[600px]:text-[1.15rem] max-[600px]:text-navy">Come along for a game, meet local players, and enjoy table tennis at Saxton Field. New players are welcome.</p>
      <div class="mt-[2.1rem] flex max-[600px]:mt-6">
        <ButtonLink href="/sessions/" class="max-[600px]:w-full max-[600px]:text-[1.05rem]">View sessions</ButtonLink>
      </div>
    </Container>
  </section>

  <Container as="section" id="visit" aria-labelledby="visit-title" class="grid grid-cols-[minmax(0,1fr)_minmax(0,.78fr)] items-center gap-[clamp(2rem,4vw,4rem)] py-[clamp(4rem,7vw,7rem)] max-[780px]:grid-cols-1 max-[780px]:py-14 max-[600px]:flex max-[600px]:flex-col max-[600px]:items-stretch max-[600px]:gap-[1.4rem] max-[600px]:pt-4 max-[600px]:pb-12">
    <div>
      <h2 id="visit-title" class="mt-0 mb-[1.4rem] text-[clamp(2.5rem,4.4vw,4.5rem)] font-bold leading-[1.05] tracking-[-.055em] max-[600px]:mb-4 max-[600px]:text-[clamp(2.25rem,9vw,3rem)]">Ready to give it a go?</h2>
      <p class="mt-0 mb-4 max-w-[540px] text-[1.13rem] text-muted max-[600px]:m-0 max-[600px]:text-[1.15rem] max-[600px]:leading-normal max-[600px]:text-navy">You don’t need your own bat or ball. Just bring non-marking shoes and come ready to play.</p>
      <ButtonLink class="mt-4 max-[600px]:w-full max-[600px]:text-[1.05rem]" href="https://www.sporty.co.nz/ttnelson/" target="_blank" rel="noopener noreferrer">See playing times <span aria-hidden="true">↗</span></ButtonLink>
    </div>
    <Image class="block aspect-[3/2] h-auto w-full rounded-md object-cover max-[600px]:order-first max-[600px]:-mx-4 max-[600px]:w-[calc(100%_+_2rem)] max-[600px]:max-w-none max-[600px]:rounded-none" src={welcomePhoto} alt="Two women smiling as they play table tennis together" widths={[360, 600, 900, 1200]} sizes="(max-width: 600px) 100vw, (max-width: 780px) calc(100vw - 2rem), (max-width: 1250px) 40vw, 500px" loading="lazy" />
  </Container>

  <section id="find-us" aria-labelledby="location-title" class="bg-pale-blue py-[clamp(4rem,7vw,6rem)] max-[780px]:py-14 max-[600px]:py-12">
    <Container class="grid grid-cols-2 items-center gap-[clamp(2rem,5vw,5rem)] max-[780px]:grid-cols-1 max-[780px]:gap-8">
      <div>
        <div>
          <h2 id="location-title" class="mt-0 mb-[1.2rem] text-[clamp(2.5rem,4.4vw,4.5rem)] font-bold leading-[1.05] tracking-[-.055em] max-[600px]:text-[clamp(2.25rem,9vw,3rem)]">See you at the table.</h2>
          <p class="mt-0 mb-6 text-muted max-[600px]:text-[1.1rem]">Saxton Field Stadium<br />142 Saxton Road, Stoke, Nelson</p>
        </div>
        <a class="pb-[.3rem] font-extrabold whitespace-nowrap underline decoration-2 underline-offset-[5px] hover:text-blue-dark" href={directions} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
      </div>
      <iframe class="block h-[360px] w-full rounded-md border-0 bg-soft-blue max-[600px]:h-[290px]" title="Map showing Table Tennis Nelson at Saxton Field Stadium" src="https://www.google.com/maps?q=Table+Tennis+Nelson%2C+142+Saxton+Road%2C+Stoke%2C+Nelson%2C+New+Zealand&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </Container>
  </section>
</SiteLayout>
