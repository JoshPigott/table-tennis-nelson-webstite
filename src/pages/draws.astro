---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import PageHeading from '../components/PageHeading.astro';
---

<SiteLayout title="Draws | Table Tennis Nelson" description="Find team lists and competition draws for Table Tennis Nelson.">
  <PageIntro>
    <PageHeading>Draws</PageHeading>
    <p class="m-0 max-w-[42rem] text-xl leading-[1.65]">Thursday night competition draws.</p>
  </PageIntro>
  <Container as="section" size="reading" mobileAt="650" class="py-[clamp(2.5rem,6vw,4rem)]" aria-label="Competition draws">
    <p id="draws-status" role="status" class="m-0 text-[1.1rem] leading-[1.65]">Loading draws...</p>
    <ul id="draws-list" class="m-0 list-none p-0"></ul>
    <template id="draw-template">
      <li class="border-b border-soft-blue first:border-t"><a class="flex items-center justify-between gap-6 py-6 text-[1.2rem] font-bold no-underline [overflow-wrap:anywhere] max-[650px]:gap-4 max-[650px]:pr-3 max-[650px]:text-[1.1rem]" target="_blank" rel="noopener noreferrer"><span></span><span class="shrink-0 text-[.95rem] text-blue-dark underline underline-offset-3">View PDF</span></a></li>
    </template>
    <nav class="mt-8 flex items-center justify-center gap-4 [&_a]:min-h-11 [&_a]:rounded-md [&_a]:border [&_a]:border-blue-dark [&_a]:bg-paper [&_a]:px-4 [&_a]:py-2 [&_a]:font-bold [&_a]:text-blue-dark [&_a]:no-underline" id="draws-pagination" aria-label="Draws pages" hidden></nav>
  </Container>
</SiteLayout>

<script>
  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const status = document.getElementById('draws-status')!;
  const list = document.getElementById('draws-list')!;
  const template = document.getElementById('draw-template') as HTMLTemplateElement;
  const pagination = document.getElementById('draws-pagination')!;
  const requestedPage = Number(new URLSearchParams(location.search).get('page'));
  const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

  async function loadDraws() {
    try {
      const url = new URL(`/api/draws?populate=document&sort=createdAt:desc&status=published&pagination[page]=${page}&pagination[pageSize]=8`, cmsUrl);
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error('Could not load draws');
      const { data, meta } = await response.json();
      for (const draw of data) {
        if (!draw.document?.url) continue;
        const href = new URL(draw.document.url, cmsUrl);
        if (!['http:', 'https:'].includes(href.protocol)) continue;
        const item = template.content.cloneNode(true) as DocumentFragment;
        const link = item.querySelector('a')!;
        link.href = href.href;
        link.setAttribute('aria-label', `${draw.title} (opens in a new tab)`);
        link.firstElementChild!.textContent = draw.title;
        link.lastElementChild!.textContent = draw.document.mime === 'application/pdf' ? 'View PDF' : 'View draw';
        list.append(item);
      }
      const pageCount = Number(meta.pagination.pageCount);
      pagination.innerHTML = `
        ${page > 1 ? `<a href="?page=${page - 1}">Previous</a>` : ''}
        <span>Page ${page} of ${pageCount}</span>
        ${page < pageCount ? `<a href="?page=${page + 1}">Next</a>` : ''}`;
      status.textContent = list.childElementCount ? '' : 'Draws will appear here when they are available.';
      pagination.hidden = pageCount <= 1;
    } catch {
      list.replaceChildren();
      status.textContent = 'Draws are unavailable right now. Please try again later.';
    }
  }

  loadDraws();
</script>
