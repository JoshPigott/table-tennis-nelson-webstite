---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Draws | Table Tennis Nelson" description="Find team lists and competition draws for Table Tennis Nelson.">
  <header class="page-intro">
    <div class="wrap">
      <h1>Draws</h1>
      <p>Thursday night competition draws.</p>
    </div>
  </header>
  <section class="wrap content" aria-label="Competition draws">
    <p id="draws-status" role="status">Loading draws...</p>
    <ul id="draws-list"></ul>
    <template id="draw-template">
      <li><a target="_blank" rel="noopener noreferrer"><span></span><span class="file-label">View PDF</span></a></li>
    </template>
    <nav class="pagination" id="draws-pagination" aria-label="Draws pages" hidden></nav>
  </section>
</SiteLayout>

<script>
  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const status = document.getElementById('draws-status')!;
  const list = document.getElementById('draws-list')!;
  const template = document.getElementById('draw-template') as HTMLTemplateElement;
  const pagination = document.getElementById('draws-pagination')!;
  const requestedPage = Number(new URLSearchParams(location.search).get('page'));
  const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

  async function loadDraws() {
    try {
      const url = new URL(`/api/draws?populate=document&sort=createdAt:desc&status=published&pagination[page]=${page}&pagination[pageSize]=8`, cmsUrl);
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error('Could not load draws');
      const { data, meta } = await response.json();
      for (const draw of data) {
        if (!draw.document?.url) continue;
        const href = new URL(draw.document.url, cmsUrl);
        if (!['http:', 'https:'].includes(href.protocol)) continue;
        const item = template.content.cloneNode(true) as DocumentFragment;
        const link = item.querySelector('a')!;
        link.href = href.href;
        link.setAttribute('aria-label', `${draw.title} (opens in a new tab)`);
        link.firstElementChild!.textContent = draw.title;
        link.lastElementChild!.textContent = draw.document.mime === 'application/pdf' ? 'View PDF' : 'View draw';
        list.append(item);
      }
      const pageCount = Number(meta.pagination.pageCount);
      pagination.innerHTML = `
        ${page > 1 ? `<a href="?page=${page - 1}">Previous</a>` : ''}
        <span>Page ${page} of ${pageCount}</span>
        ${page < pageCount ? `<a href="?page=${page + 1}">Next</a>` : ''}`;
      status.textContent = list.childElementCount ? '' : 'Draws will appear here when they are available.';
      pagination.hidden = pageCount <= 1;
    } catch {
      list.replaceChildren();
      status.textContent = 'Draws are unavailable right now. Please try again later.';
    }
  }

  loadDraws();
</script>

<style>
  .wrap { width: min(100% - 3rem, 1000px); margin-inline: auto; }
  .page-intro { padding-block: clamp(3rem, 6vw, 5rem); background: var(--pale-blue); }
  h1 { margin: 0 0 1rem; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.15; letter-spacing: -.04em; }
  p { margin: 0; font-size: 1.1rem; line-height: 1.65; }
  .page-intro p { max-width: 42rem; font-size: 1.25rem; }
  .content { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem; }
  .pagination[hidden] { display: none; }
  .pagination :global(a) { min-height: 44px; padding: .5rem 1rem; border: 1px solid var(--blue-dark); border-radius: 6px; background: var(--paper); color: var(--blue-dark); font: inherit; font-weight: 700; text-decoration: none; }
  #draws-list { margin: 0; padding: 0; list-style: none; }
  #draws-list :global(li) { border-bottom: 1px solid var(--soft-blue); }
  #draws-list :global(li:first-child) { border-top: 1px solid var(--soft-blue); }
  #draws-list :global(a) { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding-block: 1.5rem; font-size: 1.2rem; font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
  #draws-list :global(.file-label) { flex-shrink: 0; color: var(--blue-dark); font-size: .95rem; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 650px) {
    .wrap { width: calc(100% - 2rem); }
    h1 { font-size: clamp(2.25rem, 10vw, 3rem); }
    #draws-list :global(a) { gap: 1rem; padding-right: .75rem; font-size: 1.1rem; }
  }
</style>
