---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import juniorGroup from '../assets/coaching/junior-group.webp';
import dimitriBell from '../assets/coaching/dimitri-bell.webp';
import johnCoaching from '../assets/coaching/john-jary-coaching.webp';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import PageHeading from '../components/PageHeading.astro';
import PageStatus from '../components/PageStatus.astro';
---

<SiteLayout title="Coaching | Table Tennis Nelson" description="Junior group coaching, individual training, and the junior pathway at Table Tennis Nelson.">
  <PageIntro size="medium">
    <PageHeading id="coaching-heading" data-field="pageHeading">Coaching</PageHeading>
    <p id="coaching-introduction" data-field="pageIntroduction" hidden class="mt-0 mb-0 max-w-[42rem] text-[1.2rem] leading-[1.6]"></p>
  </PageIntro>
  <PageStatus id="coaching-status" size="medium" mobileAt="600">Loading coaching information…</PageStatus>
  <Container as="section" size="medium" class="py-[clamp(3rem,6vw,5rem)]" aria-labelledby="after-school-title" hidden>
    <div class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] items-stretch gap-x-[clamp(2rem,4vw,4rem)] [grid-template-areas:'heading_image'_'schedule_image'] max-[800px]:grid-cols-1 max-[800px]:gap-6 max-[800px]:[grid-template-areas:'heading'_'image'_'schedule']">
      <div class="[grid-area:heading]">
        <h2 id="after-school-title" data-field="groupHeading" class="mt-0 mb-[.9rem] text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.15] tracking-[-.04em]"></h2>
        <p id="group-introduction" data-field="groupIntroduction" class="mt-0 mb-[1.8rem] max-w-[44rem] text-[1.1rem] leading-[1.6] text-muted max-[800px]:mb-0"></p>
      </div>
      <div class="[grid-area:schedule]">
        <div id="coaching-sessions" class="grid max-w-[760px] grid-cols-2 gap-4 max-[600px]:grid-cols-1 [&>div]:rounded-xl [&>div]:border [&>div]:border-soft-blue [&>div]:bg-pale-blue [&>div]:p-6 [&_h3]:mt-0 [&_h3]:mb-[.35rem] [&_h3]:text-xl [&_h3]:font-bold [&_h3]:leading-[1.15] [&_h3]:tracking-[-.04em] [&_p]:m-0 [&_p]:text-xl [&_p]:font-extrabold [&_p]:leading-[1.6] [&_p]:text-blue-dark"></div>
        <p id="group-contact" hidden class="mt-8 mb-0 leading-[1.6] [&_a]:font-bold [&_a]:text-blue-dark [&_a]:underline [&_a]:underline-offset-3"></p>
      </div>
      <Image class="block h-full max-h-[400px] min-h-0 w-full rounded-xl object-cover [grid-area:image] max-[800px]:mx-auto max-[800px]:h-auto max-[800px]:w-[min(100%,540px)]" src={juniorGroup} alt="Junior players gathered around table tennis tables during a group session" widths={[360, 540, 720, 1080]} sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px" loading="lazy" />
    </div>
  </Container>

  <section class="bg-pale-blue py-[clamp(3rem,6vw,5rem)]" aria-labelledby="individual-title" hidden>
    <Container size="medium" class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] items-stretch gap-[clamp(2rem,4vw,4rem)] max-[800px]:grid-cols-1">
      <div>
        <h2 id="individual-title" data-field="individualHeading" class="mt-0 mb-[.9rem] text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.15] tracking-[-.04em]"></h2>
        <p id="individual-introduction" data-field="individualIntroduction" class="mt-0 mb-[1.8rem] max-w-[44rem] text-[1.1rem] leading-[1.6] text-muted"></p>
        <div class="grid grid-cols-1 gap-6">
          <p id="individual-details" data-field="individualDetails" class="m-0 leading-[1.6]"></p>
          <div id="individual-contact" hidden class="flex flex-wrap gap-x-8 gap-y-4 [&_p]:m-0 [&_p]:leading-[1.6] [&_a]:font-bold [&_a]:text-blue-dark [&_a]:underline [&_a]:underline-offset-3">
            <p id="john-sms-row" hidden><strong>Text preferred</strong><br /><a id="john-sms"></a></p>
            <p id="john-email-row" hidden><strong>Email</strong><br /><a id="john-email"></a></p>
          </div>
        </div>
      </div>
      <Image class="block h-full max-h-[400px] min-h-0 w-full rounded-xl object-cover max-[800px]:mx-auto max-[800px]:h-auto max-[800px]:w-[min(100%,540px)]" src={johnCoaching} alt="John Jary feeding table tennis balls across the table during a coaching session" widths={[360, 480, 598]} sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px" loading="lazy" />
    </Container>
  </section>

  <Container as="section" size="medium" class="py-[clamp(3rem,6vw,5rem)] max-[800px]:flex max-[800px]:flex-col" aria-labelledby="pathway-title" hidden>
    <Image class="float-right mt-0 mr-0 mb-6 ml-[clamp(2rem,4vw,4rem)] block h-auto w-[42%] rounded-xl object-contain max-[800px]:order-2 max-[800px]:float-none max-[800px]:mx-auto max-[800px]:w-[min(100%,540px)]" src={dimitriBell} alt="Nelson player Dimitri Bell preparing to return a table tennis ball" widths={[360, 540, 720, 1080]} sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px" loading="lazy" />
    <div class="mb-2 max-[800px]:order-1">
      <h2 id="pathway-title" data-field="pathwayHeading" class="mt-0 mb-[.9rem] text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.15] tracking-[-.04em]"></h2>
      <p id="pathway-introduction" data-field="pathwayIntroduction" class="m-0 max-w-[44rem] text-[1.1rem] leading-[1.6] text-muted"></p>
    </div>
    <ol id="pathway-steps" class="m-0 list-decimal pl-8 max-[800px]:order-3 [&_li]:border-t [&_li]:border-soft-blue [&_li]:py-5 [&_li]:pl-2 [&_li]:[display:list-item_flow-root] [&_li:first-child]:pt-3 [&_li::marker]:font-extrabold [&_li::marker]:text-blue-dark [&_h3]:mt-0 [&_h3]:mb-[.35rem] [&_h3]:text-xl [&_h3]:font-bold [&_h3]:leading-[1.15] [&_h3]:tracking-[-.04em] [&_p]:m-0 [&_p]:leading-[1.6] [&_a]:font-bold [&_a]:text-blue-dark [&_a]:underline [&_a]:underline-offset-3"></ol>
  </Container>
</SiteLayout>

<script>
    const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
    const byId = (id: string) => document.getElementById(id)!;
    const escapeHtml = (value: unknown) => {
      const element = document.createElement('div');
      element.textContent = String(value ?? '');
      return element.innerHTML.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    };

    async function loadCoaching() {
      try {
        if (!cmsUrl) throw new Error('Strapi URL is missing');
        const url = new URL('/api/coaching-page?populate[0]=groupSessions&populate[1]=pathwaySteps&populate[2]=groupContactSection&populate[3]=groupContactSection.contacts', cmsUrl);
        const response = await fetch(url, { cache: 'no-store' });
        if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
        const { data } = await response.json();
        if (!data?.groupSessions?.length || !data?.pathwaySteps?.length) throw new Error('Coaching page is incomplete');

        document.querySelectorAll<HTMLElement>('[data-field]').forEach((element) => {
          element.textContent = data[element.dataset.field!];
        });

        byId('coaching-sessions').innerHTML = data.groupSessions
          .map(({ day, time }: { day: string; time: string }) => `<div><h3>${escapeHtml(day)}</h3><p>${escapeHtml(time)}</p></div>`)
          .join('');

        const contacts = data.groupContactSection?.contacts ?? [];
        if (contacts.length) {
          byId('group-contact').innerHTML = `${escapeHtml(data.groupContactSection.introduction || '')} ${contacts
            .map(({ name, phone }: { name: string; phone: string }) => `<a href="tel:${phone.replace(/[^\d+]/g, '')}">${escapeHtml(name)} on ${escapeHtml(phone)}</a>`)
            .join(' or ')}.`;
          byId('group-contact').hidden = false;
        }

        const phone = data.johnPhone?.trim();
        const email = data.johnEmail?.trim();
        byId('john-sms-row').hidden = !phone;
        byId('john-email-row').hidden = !email;
        byId('individual-contact').hidden = !phone && !email;
        if (phone) {
          byId('john-sms').textContent = phone;
          byId('john-sms').setAttribute('href', `sms:${phone.replace(/[^\d+]/g, '')}`);
        }
        if (email) {
          byId('john-email').textContent = email;
          byId('john-email').setAttribute('href', `mailto:${email}`);
        }

        byId('pathway-steps').innerHTML = data.pathwaySteps.map((step: { title: string; description: string; linkText?: string; linkUrl?: string; afterLink?: string }) => {
          const url = step.linkUrl || '';
          const link = step.linkText && /^(https?:\/\/|mailto:)/i.test(url)
            ? `<a href="${escapeHtml(url)}"${/^https?:\/\//i.test(url) ? ' target="_blank" rel="noopener noreferrer"' : ''}>${escapeHtml(step.linkText)}</a>${escapeHtml(step.afterLink)}`
            : '';
          return `<li><h3>${escapeHtml(step.title)}</h3><p>${escapeHtml(step.description)}${link}</p></li>`;
        }).join('');

        byId('coaching-introduction').hidden = false;
        for (const id of ['after-school-title', 'individual-title', 'pathway-title']) {
          document.querySelector(`section[aria-labelledby="${id}"]`)!.removeAttribute('hidden');
        }
        byId('coaching-status').hidden = true;
      } catch (error) {
        byId('coaching-status').textContent = 'Coaching information is unavailable right now. Please try again later.';
        console.warn('Could not load coaching page from Strapi:', error);
      }
    }

    loadCoaching();
  </script>
