---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import juniorGroup from '../assets/coaching/junior-group.webp';
import dimitriBell from '../assets/coaching/dimitri-bell.webp';
import johnCoaching from '../assets/coaching/john-jary-coaching.webp';
---

<SiteLayout title="Coaching | Table Tennis Nelson" description="Junior group coaching, individual training, and the junior pathway at Table Tennis Nelson.">
  <header class="page-intro">
    <div class="wrap">
      <h1>Coaching</h1>
      <p>There are ways to learn, practise, and take your table tennis further at Table Tennis Nelson.</p>
    </div>
  </header>

  <section class="wrap section" aria-labelledby="after-school-title">
    <div class="coaching-overview">
      <div>
        <h2 id="after-school-title">After school coaching</h2>
        <p class="section-intro">Junior group coaching runs during the school term.</p>
    
        <div class="session-grid">
          <div class="session">
            <h3>Monday</h3>
            <p>3:45pm–5:00pm</p>
          </div>
          <div class="session">
            <h3>Friday</h3>
            <p>3:30pm–4:30pm</p>
          </div>
        </div>
    
        <p class="contact-line">For individual coaching, contact <a href="tel:02108408652">Mark on 021 084 08652</a> or <a href="tel:0284208071">John on 028 420 8071</a>.</p>
      </div>
      <Image
        class="coaching-photo"
        src={juniorGroup}
        alt="Junior players gathered around table tennis tables during a group session"
        widths={[360, 540, 720, 1080]}
        sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px"
        loading="lazy"
      />
    </div>
  </section>

  <section class="individual" aria-labelledby="individual-title">
    <div class="wrap coaching-overview">
      <div>
        <h2 id="individual-title">Individual coaching with John Jary</h2>
        <p class="section-intro">New to table tennis? John offers free one-to-one coaching to help you get started.</p>
        <div class="individual-details">
          <p>Morning, afternoon, or evening, seven days a week except Sunday evening. Book in advance if you can: choose a day and time, and John can be at the stadium within 10 minutes.</p>
          <div class="contact-details">
            <p><strong>Text preferred</strong><br /><a href="sms:0284208071">028 420 8071</a></p>
            <p><strong>Email</strong><br /><a href="mailto:johnjohnjary@gmail.com">johnjohnjary@gmail.com</a></p>
          </div>
        </div>
        </div>
        <Image
          class="coaching-photo"
          src={johnCoaching}
          alt="John Jary feeding table tennis balls across the table during a coaching session"
          widths={[360, 480, 598]}
          sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px"
          loading="lazy"
        />
      </div>
    </section>
  
    <section class="wrap section pathway" aria-labelledby="pathway-title">
      <div class="pathway-intro">
        <div>
          <h2 id="pathway-title">The junior pathway</h2>
          <p class="section-intro">A guide to getting started and progressing through the Table Tennis Nelson junior programme.</p>
        </div>
        <Image
          class="coaching-photo"
          src={dimitriBell}
          alt="Nelson player Dimitri Bell preparing to return a table tennis ball"
          widths={[360, 540, 720, 1080]}
          sizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 1150px) 45vw, 510px"
          loading="lazy"
        />
      </div>
  
      <ol>
        <li>
          <h3>Come along and play</h3>
          <p>Start with Monday after school juniors during the school term, or try a family session on Sunday morning or Wednesday evening.</p>
        </li>
        <li>
          <h3>Try Friday competition</h3>
          <p>Play in the Friday after school competition during terms 2 and 3.</p>
        </li>
        <li>
          <h3>Watch table tennis</h3>
          <p>Watch matches and learn from the players on <a href="https://www.youtube.com/WTTGlobal" target="_blank" rel="noopener noreferrer">World Table Tennis</a>.</p>
        </li>
        <li>
          <h3>Consider extra coaching</h3>
          <p>Email <a href="mailto:tabletennisnelson@outlook.com">Table Tennis Nelson</a> to ask about coaching. Coaches at the stadium include Mark Nalder, Allan Viller, John Jary, Anna King, Dimitri Bell, and Michael Holmes. Coaching can be one to one or in a group of up to four friends. Ask each coach about any fee. Individual coaching can help you develop faster than larger group sessions.</p>
        </li>
        <li>
          <h3>Register with Table Tennis New Zealand</h3>
          <p>Get familiar with the events on offer.</p>
        </li>
        <li>
          <h3>Enter tournaments</h3>
          <p>Start with the Nelson Closed, Nelson Open, or Marlborough Open. You could then consider events in Wellington, Otago, Canterbury, and the New Zealand National Championships. Check the <a href="https://tabletennis.org.nz/tournaments/national-tournament-calendar" target="_blank" rel="noopener noreferrer">Table Tennis New Zealand tournament calendar</a> for current events and dates.</p>
        </li>
        <li>
          <h3>Play Thursday competition</h3>
          <p>Take part in Thursday night competitive play.</p>
        </li>
        <li>
          <h3>Represent Nelson</h3>
          <p>Play in Nelson representative teams, including the South Island Team Championships and the shield match with Marlborough.</p>
        </li>
        <li>
          <h3>Attend training camps</h3>
          <p>Work towards selection for the Table Tennis New Zealand South Region training camp and the national training camp.</p>
        </li>
      </ol>
    </section>
  </SiteLayout>
  
  <style>
    .wrap { width: min(100% - 3rem, 1100px); margin-inline: auto; }
    h1, h2, h3, p { margin-top: 0; }
    h1, h2, h3 { line-height: 1.15; letter-spacing: -.04em; }
    h1 { margin-bottom: 1rem; font-size: clamp(3rem, 6vw, 5rem); }
    h2 { margin-bottom: .9rem; font-size: clamp(2rem, 4vw, 3rem); }
    h3 { margin-bottom: .35rem; font-size: 1.25rem; }
    p { line-height: 1.6; }
    a { color: var(--blue-dark); font-weight: 700; text-underline-offset: 3px; }
    .page-intro { padding-block: clamp(3rem, 6vw, 5rem); background: var(--pale-blue); }
    .page-intro p { max-width: 42rem; margin-bottom: 0; font-size: 1.2rem; }
    .section { padding-block: clamp(3rem, 6vw, 5rem); }
    .section-intro { max-width: 44rem; margin-bottom: 1.8rem; color: var(--muted); font-size: 1.1rem; }
    .session-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 760px; }
    .session { padding: 1.5rem; border: 1px solid var(--soft-blue); border-radius: 12px; background: var(--pale-blue); }
    .session p { margin-bottom: 0; color: var(--blue-dark); font-size: 1.25rem; font-weight: 800; }
    .contact-line { margin: 2rem 0 0; }
    .coaching-overview, .pathway-intro { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2rem, 4vw, 4rem); align-items: stretch; }
    .coaching-photo { display: block; width: 100%; height: 100%; max-height: 400px; min-height: 0; object-fit: cover; border-radius: 12px; }
    .pathway-intro { margin-bottom: 2.5rem; }
    .pathway-intro .section-intro { margin-bottom: 0; }
    .individual { padding-block: clamp(3rem, 6vw, 5rem); background: var(--pale-blue); }
    .individual-details { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
    .individual-details > p { margin-bottom: 0; }
    .contact-details { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
    .contact-details p { margin-bottom: 0; }
    .pathway ol { max-width: 850px; margin: 0; padding-left: 2rem; }
    .pathway li { padding: 1.25rem 0 1.25rem .5rem; border-top: 1px solid var(--soft-blue); }
    .pathway li::marker { color: var(--blue-dark); font-weight: 800; }
    .pathway li p { margin-bottom: 0; }
    @media (max-width: 800px) {
      .coaching-overview, .pathway-intro { grid-template-columns: 1fr; }
      .coaching-photo { width: min(100%, 540px); height: auto; margin-inline: auto; }
    }
    @media (max-width: 600px) {
      .wrap { width: min(100% - 2rem, 1100px); }
      .session-grid, .individual-details { grid-template-columns: 1fr; }
      .contact-details { padding-left: 0; border-left: 0; }
    }
  </style>
