---
import SiteLayout from '../layouts/SiteLayout.astro';
import playerPhoto from '../assets/para-power/wheelchair-table-tennis.png';
import sessionPhoto from '../assets/para-power/players-together.png';
import Container from '../components/Container.astro';
import PageStatus from '../components/PageStatus.astro';
import PageHeading from '../components/PageHeading.astro';
import PhotoHero from '../components/PhotoHero.astro';
import RichText from '../components/RichText.astro';
import ContactBand from '../components/ContactBand.astro';
---

<SiteLayout title="Para Power – Table Tennis | Table Tennis Nelson" description="Join Para Power table tennis for people with a physical or intellectual impairment. Thursdays, 4–5pm during school terms at Saxton Field, Nelson. $25 per term.">
  <PageStatus id="para-power-status">Loading Para Power information...</PageStatus>
  <div id="para-power-page" hidden>
    <PhotoHero src={playerPhoto} alt="Wheelchair table tennis players enjoying a game at the Nelson stadium" widths={[640, 960, 1280, 1600, 2048]} quality={90}>
      <PageHeading hero id="hero-title" class="whitespace-pre-line" />
    </PhotoHero>
    <Container size="reading" mobileAt="650" class="pt-[clamp(3rem,6vw,5rem)] pb-[clamp(2rem,4vw,3rem)]">
      <RichText as="article" id="main-content" lead />
    </Container>
    <ContactBand para label="Benefits, contact and more information" src={sessionPhoto} alt="Two players smiling together beside the table tennis tables at the Nelson stadium" />
  </div>
</SiteLayout>

<script>
  import MarkdownIt from 'markdown-it';

  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const byId = (id: string) => document.getElementById(id)!;
  const markdown = new MarkdownIt({ linkify: true });
  markdown.disable('image');

  async function loadPage() {
    try {
      if (!cmsUrl) throw new Error('Strapi URL is missing');
      const url = new URL('/api/para-power-page', cmsUrl);
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
      const { data } = await response.json();
      if (!data?.heroTitle || !data?.mainContent) {
        throw new Error('Para Power page is incomplete');
      }

      byId('hero-title').textContent = data.heroTitle.trim().replace(/\s+(Table Tennis)$/i, '\n$1');
      byId('main-content').innerHTML = markdown.render(data.mainContent);
      byId('contact-band').hidden = !data.contactContent?.trim();
      byId('contact-content').innerHTML = markdown.render(data.contactContent || '');

      byId('para-power-page').hidden = false;
      byId('para-power-status').hidden = true;
    } catch (error) {
      byId('para-power-status').textContent = 'Para Power information is unavailable right now. Please try again later.';
      console.warn('Could not load Para Power page from Strapi:', error);
    }
  }

  loadPage();
</script>
