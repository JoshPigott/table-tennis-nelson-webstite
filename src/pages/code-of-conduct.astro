---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageStatus from '../components/PageStatus.astro';
import PageIntro from '../components/PageIntro.astro';
import PageHeading from '../components/PageHeading.astro';
import RichText from '../components/RichText.astro';
---

<SiteLayout title="Code of Conduct | Table Tennis Nelson" description="Stadium rules and the code of conduct for players, members and visitors at Table Tennis Nelson.">
  <PageStatus id="conduct-status">Loading code of conduct...</PageStatus>
  <div id="conduct-page" hidden>
    <PageIntro>
      <PageHeading id="page-title" />
      <p class="m-0 max-w-[42rem] text-xl leading-[1.65]" id="page-introduction"></p>
    </PageIntro>
    <Container size="reading" mobileAt="650" class="py-[clamp(2.5rem,6vw,4rem)]">
      <RichText as="article" variant="conduct" id="page-content" />
    </Container>
  </div>
</SiteLayout>

<script>
  import MarkdownIt from 'markdown-it';

  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const byId = (id: string) => document.getElementById(id)!;
  const markdown = new MarkdownIt({ linkify: true });
  markdown.disable('image');

  async function loadPage() {
    try {
      if (!cmsUrl) throw new Error('Strapi URL is missing');
      const response = await fetch(new URL('/api/code-of-conduct-page', cmsUrl), { cache: 'no-store' });
      if (!response.ok) throw new Error('Could not load code of conduct');
      const { data } = await response.json();
      if (!data?.title || !data?.content) throw new Error('Code of conduct page is incomplete');

      byId('page-title').textContent = data.title;
      byId('page-introduction').textContent = data.introduction || '';
      byId('page-introduction').hidden = !data.introduction?.trim();
      byId('page-content').innerHTML = markdown.render(data.content);
      byId('conduct-page').hidden = false;
      byId('conduct-status').hidden = true;
    } catch (error) {
      byId('conduct-status').textContent = 'The code of conduct is unavailable right now. Please try again later.';
      console.warn('Could not load code of conduct from Strapi:', error);
    }
  }

  loadPage();
</script>
