---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import groupPhoto from '../assets/ping-pong-parkinsons/nelson-group-hero.png';
import playersAtTable from '../assets/ping-pong-parkinsons/players-at-table.png';
---

<SiteLayout
  title="Ping Pong Parkinson’s | Table Tennis Nelson"
  description="Join Table Tennis Nelson's Ping Pong Parkinson's sessions on Friday afternoons during school terms."
>
  <p class="wrap page-status" id="parkinsons-status" role="status">Loading Ping Pong Parkinson’s information…</p>
  <div id="parkinsons-page" hidden>
    <header class="hero">
      <Image class="hero-image" src={groupPhoto} alt="Table Tennis Nelson players and supporters standing together in the club hall" loading="eager" fetchpriority="high" />
      <div class="wrap hero-title"><h1><span data-field="heroTitleTop"></span> <span data-field="heroTitleBottom"></span></h1></div>
    </header>

    <article class="wrap content" id="main-content"></article>

    <section class="contact-band" id="contact-band" aria-label="Contact and more information">
      <div class="wrap story-row">
        <div class="contact-copy" id="contact-content"></div>
        <Image class="photo" src={playersAtTable} alt="Two players rallying across a table at Table Tennis Nelson" loading="lazy" />
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  import MarkdownIt from 'markdown-it';

  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const byId = (id: string) => document.getElementById(id)!;
  const markdown = new MarkdownIt({ linkify: true });
  markdown.disable('image');

  async function loadPage() {
    try {
      if (!cmsUrl) throw new Error('Strapi URL is missing');
      const url = new URL('/api/ping-pong-parkinsons-page', cmsUrl);
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
      const { data } = await response.json();
      if (!data?.heroTitleTop || !data?.heroTitleBottom || !data?.mainContent) {
        throw new Error('Ping Pong Parkinson’s page is incomplete');
      }

      document.querySelectorAll<HTMLElement>('[data-field]').forEach((element) => {
        element.textContent = data[element.dataset.field!];
      });
      byId('main-content').innerHTML = markdown.render(data.mainContent);
      byId('contact-band').hidden = !data.contactContent?.trim();
      if (data.contactContent) byId('contact-content').innerHTML = markdown.render(data.contactContent);

      byId('parkinsons-page').hidden = false;
      byId('parkinsons-status').hidden = true;
    } catch (error) {
      byId('parkinsons-status').textContent = 'Ping Pong Parkinson’s information is unavailable right now. Please try again later.';
      console.warn('Could not load Ping Pong Parkinson’s page from Strapi:', error);
    }
  }

  loadPage();
</script>

<style>
  .wrap { width: min(100% - 3rem, 1000px); margin-inline: auto; }
  .page-status { padding-block: 3rem; }
  .hero { position: relative; height: 100svh; min-height: 540px; display: flex; align-items: end; overflow: hidden; background: var(--navy); }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 45%, rgb(0 0 0 / .72)); }
  .hero :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-title { position: relative; z-index: 1; padding-bottom: clamp(2rem, 6vw, 5rem); color: white; }
  .hero-title h1 span { display: block; }
  .content { padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.1; letter-spacing: -.04em; }
  .content :global(h2), .contact-copy :global(h2) { margin: 0 0 1rem; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -.03em; }
  .content :global(h3), .contact-copy :global(h3) { margin: 1.5rem 0 .75rem; font-size: 1.4rem; }
  .content :global(p), .contact-copy :global(p) { margin: 0 0 1.25rem; font-size: 1.1rem; line-height: 1.65; }
  .content :global(p:first-of-type) { font-size: 1.25rem; }
  .content :global(p) { max-width: 45rem; }
  .content :global(a), .contact-copy :global(a) { color: var(--blue-dark); font-weight: 700; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .contact-band { padding-block: clamp(3rem, 6vw, 5rem); background: var(--pale-blue); }
  .story-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .contact-copy :global(p:last-child) { margin-bottom: 0; }
  .photo { display: block; width: 100%; height: auto; border-radius: 12px; }
  @media (max-width: 650px) {
    .wrap { width: min(100% - 2rem, 1000px); }
    .hero { display: block; height: auto; min-height: 0; background: var(--pale-blue); }
    .hero::after { display: none; }
    .hero :global(img) { position: static; display: block; height: auto; object-fit: contain; }
    .hero-title { padding-block: 1.5rem 2rem; color: var(--navy); }
    .hero-title h1 span { display: inline; }
    h1 { font-size: clamp(2.25rem, 10vw, 3rem); }
    .story-row { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
