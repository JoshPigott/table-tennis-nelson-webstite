---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import clubPhoto from '../assets/strategic-plan/players-having-fun.jpg';

const pdf = '/documents/ttn-strategic-plan-2024-2027.pdf';
---

<SiteLayout
  title="Strategic Plan 2024–2027 | Table Tennis Nelson"
  description="Our purpose, vision, values and priorities for growing table tennis in the Nelson–Tasman region. Read Table Tennis Nelson's strategic plan for 2024–2027."
>
  <header class="hero">
    <Image src={clubPhoto} alt="Young players laughing together around a table tennis table at Saxton Field in Nelson" widths={[640, 960, 1280, 1600, 1877]} sizes="100vw" loading="eager" fetchpriority="high" quality={95} />
    <div class="wrap hero-copy">
      <p class="eyebrow">Our direction · 2024–2027</p>
      <h1>Our strategic plan</h1>
    </div>
  </header>

  <article class="wrap overview">
    <p class="lead">Bringing people together through table tennis in Nelson–Tasman.</p>
    <div class="purpose-vision">
      <section aria-labelledby="purpose-title">
        <h2 id="purpose-title">Our purpose</h2>
        <p>To grow table tennis across Nelson–Tasman and make it accessible to our community for years to come. We create opportunities to stay active, support physical and mental wellbeing, and enjoy social and competitive play.</p>
      </section>
      <section aria-labelledby="vision-title">
        <h2 id="vision-title">Our vision</h2>
        <p>A welcoming, positive and inspiring table tennis experience for every player.</p>
      </section>
    </div>
  </article>

  <section class="values-band" aria-labelledby="values-title">
    <div class="wrap">
      <h2 id="values-title">Our values</h2>
      <div class="values">
        <div>
          <h3>Respect</h3>
          <p class="value-word">Manaakitanga</p>
          <p>We value every individual, offering support and encouragement in their table tennis endeavours.</p>
        </div>
        <div>
          <h3>Teamwork</h3>
          <p class="value-word">Whanaungatanga</p>
          <p>We operate as a family, with strong communication and supportive relationships that create belonging and enjoyment.</p>
        </div>
        <div>
          <h3>Determination</h3>
          <p class="value-word">Kaitiakitanga</p>
          <p>We think progressively, champion change and work hard to protect Table Tennis Nelson’s legacy into the future.</p>
        </div>
        <div>
          <h3>Community</h3>
          <p>We maintain strong relationships with the wider community for the betterment of table tennis.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap priorities" aria-labelledby="priorities-title">
    <h2 id="priorities-title">Our priorities</h2>
    <p class="section-intro">Four areas guide our work towards our purpose and vision.</p>
    <ol>
      <li>
        <h3>Participation and performance</h3>
        <p>Make table tennis accessible and enjoyable for all ages and abilities, with inclusive programmes, coaching pathways and opportunities for social and competitive play.</p>
      </li>
      <li>
        <h3>Operational efficiency</h3>
        <p>Support our committee and volunteers with clear roles, effective communication and straightforward systems for membership, administration and stadium operations.</p>
      </li>
      <li>
        <h3>Governance and financial sustainability</h3>
        <p>Maintain sound financial management, develop our policies and leadership, and secure funding to support our facilities, programmes and future growth.</p>
      </li>
      <li>
        <h3>Profile and partnerships</h3>
        <p>Raise awareness of table tennis and its benefits, strengthen connections with schools and community groups, and work with sponsors and partners to create more opportunities to play.</p>
      </li>
    </ol>
  </section>

  <section class="document-band" aria-labelledby="document-title">
    <div class="wrap document-row">
      <div>
        <h2 id="document-title">Read the full plan</h2>
        <p>The Strategic Plan 2024–2027 includes our detailed action plan and the outcomes we’re working towards.</p>
      </div>
      <a class="download" href={pdf} download>Download the strategic plan <span>(PDF)</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .wrap { width: min(100% - 3rem, 1000px); margin-inline: auto; }
  h1, h2, h3 { margin-top: 0; line-height: 1.15; letter-spacing: -.04em; }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5rem); }
  h2 { margin-bottom: 1rem; font-size: clamp(1.75rem, 3vw, 2.5rem); }
  h3 { margin-bottom: .6rem; font-size: 1.3rem; }
  p { margin: 0 0 1.25rem; font-size: 1.1rem; line-height: 1.65; }
  .hero { position: relative; min-height: 420px; height: 65svh; max-height: 680px; display: flex; align-items: end; background: var(--navy); overflow: hidden; }
  .hero :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 30%, rgb(0 0 0 / .75)); }
  .hero-copy { position: relative; z-index: 1; padding-block: 3rem; color: white; }
  .eyebrow { margin-bottom: .75rem; font-size: 1rem; font-weight: 700; }
  .overview, .priorities { padding-block: clamp(3rem, 6vw, 5rem); }
  .lead { max-width: 45rem; margin-bottom: 2.5rem; font-size: 1.25rem; }
  .purpose-vision { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .purpose-vision p { margin-bottom: 0; }
  .values-band, .document-band { padding-block: clamp(3rem, 6vw, 4rem); background: var(--pale-blue); }
  .values { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3rem; margin-top: 2rem; }
  .values > div { padding-top: 1.25rem; border-top: 1px solid var(--soft-blue); }
  .values p:last-child { margin-bottom: 0; }
  .value-word { margin-bottom: .75rem; color: var(--blue-dark); font-size: 1rem; font-weight: 700; }
  .section-intro { color: var(--muted); }
  .priorities ol { margin: 2rem 0 0; padding-left: 1.75rem; }
  .priorities li { padding: 1.5rem 0 1.5rem .5rem; border-top: 1px solid var(--soft-blue); }
  .priorities li::marker { color: var(--blue-dark); font-size: 1.2rem; font-weight: 700; }
  .priorities li p { max-width: 46rem; margin-bottom: 0; }
  .document-row { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .document-row > div { max-width: 35rem; }
  .download { display: inline-block; flex-shrink: 0; padding: 1rem 1.25rem; border-radius: 6px; background: var(--blue-dark); color: white; font-weight: 700; text-decoration: none; text-align: center; }
  .download span { display: block; font-size: .9rem; font-weight: 400; }
  @media (max-width: 650px) {
    .wrap { width: min(100% - 2rem, 1000px); }
    .hero { display: block; height: auto; min-height: 0; max-height: none; background: var(--pale-blue); }
    .hero :global(img) { position: static; display: block; height: auto; }
    .hero::after { display: none; }
    .hero-copy { padding-block: 1.5rem 2rem; color: var(--navy); }
    h1 { font-size: clamp(2.25rem, 10vw, 3rem); }
    .purpose-vision, .values { grid-template-columns: 1fr; gap: 1.75rem; }
    .document-row { flex-direction: column; align-items: stretch; }
  }
</style>
