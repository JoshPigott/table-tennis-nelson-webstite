---
import SiteLayout from '../layouts/SiteLayout.astro';
import clubPhoto from '../assets/strategic-plan/players-having-fun.jpg';
import Container from '../components/Container.astro';
import PageStatus from '../components/PageStatus.astro';
import PageHeading from '../components/PageHeading.astro';
import PhotoHero from '../components/PhotoHero.astro';
import RichText from '../components/RichText.astro';
import StrategicPlanTemplates from '../components/StrategicPlanTemplates.astro';
---

<SiteLayout title="Strategic Plan | Table Tennis Nelson" description="Our purpose, vision, values and priorities for growing table tennis in the Nelson–Tasman region. Read Table Tennis Nelson's strategic plan.">
  <PageStatus id="plan-status">Loading strategic plan...</PageStatus>
  <div id="plan-page" hidden>
    <PhotoHero variant="plan" src={clubPhoto} alt="Young players laughing together around a table tennis table at Saxton Field in Nelson" widths={[640, 960, 1280, 1600, 1877]} quality={95}>
      <p class="mt-0 mb-3 text-base font-bold leading-[1.65]" data-field="period"></p>
      <PageHeading hero leading="1.15" data-field="title" />
    </PhotoHero>
    <RichText as="article" variant="plan" id="main-content" />
    <StrategicPlanTemplates />
    <section class="bg-pale-blue py-[clamp(3rem,6vw,4rem)]" id="document-band" hidden aria-labelledby="document-title">
      <Container size="reading" mobileAt="650" class="flex items-center justify-between gap-8 max-[650px]:flex-col max-[650px]:items-stretch">
        <div class="max-w-[35rem]">
          <h2 class="mt-0 mb-4 text-[clamp(1.75rem,3vw,2.5rem)] font-bold leading-[1.15] tracking-[-.04em]" id="document-title" data-field="documentHeading"></h2>
          <p class="mt-0 mb-5 text-[1.1rem] leading-[1.65]" data-field="documentDescription"></p>
        </div>
        <a class="inline-block shrink-0 rounded-md bg-blue-dark px-5 py-4 text-center font-bold text-white no-underline" id="plan-download" download><span data-field="downloadLabel"></span> <span class="block text-[.9rem] font-normal">(PDF)</span></a>
      </Container>
    </section>
  </div>
</SiteLayout>

<script>
  import MarkdownIt from 'markdown-it';

  const markdown = new MarkdownIt({ linkify: true });
  markdown.disable('image');
  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const byId = (id: string) => document.getElementById(id)!;
  function cloneTemplate(id: string): HTMLElement {
    const template = byId(id) as HTMLTemplateElement;
    return template.content.firstElementChild!.cloneNode(true) as HTMLElement;
  }

  async function loadPage() {
    try {
      if (!cmsUrl) throw new Error('Strapi URL is missing');
      const response = await fetch(new URL('/api/strategic-plan-page?populate=*', cmsUrl), { cache: 'no-store' });
      if (!response.ok) throw new Error('Could not load strategic plan');
      const { data } = await response.json();
      if (!data?.title || !data?.mainContent) {
        throw new Error('Strategic plan is incomplete');
      }
      document.querySelectorAll<HTMLElement>('[data-field]').forEach((element) => {
        const value = data[element.dataset.field!] || '';
        element.textContent = value;
        element.hidden = !value;
      });
      byId('main-content').innerHTML = markdown.render(data.mainContent);
      const content = byId('main-content');
      const overview = cloneTemplate('plan-overview-template');
      const columns = cloneTemplate('plan-columns-template');
      let section: HTMLElement = overview;
      let item: HTMLElement = overview;
      let sectionCount = 0;
      for (const element of Array.from(content.children)) {
        if (element.tagName === 'H2') {
          sectionCount++;
          section = sectionCount <= 2 ? document.createElement('section') : cloneTemplate('plan-section-template');
          section.dataset.priority = String(sectionCount > 2 && sectionCount % 2 === 0);
          (sectionCount <= 2 ? columns : content).append(section);
          item = section;
        } else if (element.tagName === 'H3') {
          item = cloneTemplate('plan-item-template');
          section.append(item);
        }
        item.append(element);
      }
      overview.append(columns);
      content.prepend(overview);
      if (data.document?.mime === 'application/pdf' && data.document.url) {
        const url = new URL(data.document.url, cmsUrl);
        if (['https:', 'http:'].includes(url.protocol)) {
          byId('plan-download').setAttribute('href', url.href);
          byId('document-band').hidden = false;
        }
      }
      document.title = data.title + ' | Table Tennis Nelson';
      byId('plan-page').hidden = false;
      byId('plan-status').hidden = true;
    } catch (error) {
      byId('plan-status').textContent = 'The strategic plan is unavailable right now. Please try again later.';
      console.warn('Could not load strategic plan from Strapi:', error);
    }
  }

  loadPage();
</script>
