---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import stadiumPhoto from '../assets/bookings/hall.webp';
---

<SiteLayout title="Venue bookings | Table Tennis Nelson" description="Download the facility booking form to hire the Saxton table tennis rooms.">
  <Container as="section" size="medium" mobileAt="650" class="grid items-center gap-8 py-12 min-[800px]:grid-cols-2" aria-labelledby="booking-title">
    <div>
      <h1 id="booking-title" class="mt-0 mb-5 text-[clamp(2.5rem,5vw,4.5rem)] font-bold leading-[1.08] tracking-[-.04em]">Venue bookings</h1>
      <p class="mt-0 mb-6 text-body">Download the booking form, complete your details, read the conditions of hire and sign it.</p>
      <a href="/documents/ttn-facility-booking-form.pdf" download class="inline-flex min-h-12 items-center justify-center rounded-md bg-blue px-5 py-3 font-medium text-white no-underline hover:bg-blue-dark">Download booking form (PDF)</a>
      <p class="mt-6 mb-4 text-muted">Email your completed, signed form to <a href="mailto:tabletennisnelson@outlook.com" class="text-blue-dark underline underline-offset-3 [overflow-wrap:anywhere]">tabletennisnelson@outlook.com</a>.</p>
      <p class="mt-0 mb-5 text-muted">We’ll confirm availability and agree the hire fee with you before your booking goes ahead.</p>
      <p class="m-0 text-sm text-muted">142 Saxton Road, Stoke, Nelson</p>
    </div>
    <Image src={stadiumPhoto} alt="A wide view of the Saxton table tennis hall with tables set up and people playing" widths={[390, 640, 960, 1280]} sizes="(max-width: 800px) calc(100vw - 2.5rem), 550px" loading="eager" class="aspect-[5/4] h-auto w-full rounded-xl object-cover object-[center_60%]" />
  </Container>
</SiteLayout>
