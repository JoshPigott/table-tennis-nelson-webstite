---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import PageHeading from '../components/PageHeading.astro';
---

<SiteLayout title="Complaints | Table Tennis Nelson" description="Read Table Tennis Nelson's complaints policy and find the form for raising a formal complaint.">
  <PageIntro>
    <PageHeading>Complaints</PageHeading>
    <p class="m-0 max-w-[42rem] text-xl leading-[1.65]">We want everyone involved in table tennis to feel respected, safe and heard.</p>
  </PageIntro>

  <Container size="reading" mobileAt="650" class="py-[clamp(2.5rem,6vw,4rem)]">
    <div class="mx-auto max-w-[48rem]">
      <section class="mb-8" aria-labelledby="policy-heading">
        <h2 id="policy-heading" class="mt-0 mb-3 text-section font-bold">Before you begin</h2>
        <p class="mt-0 mb-4 text-body">For a minor concern, try to resolve it informally first where it is safe and appropriate. A formal complaint is appropriate for a serious issue, or where informal resolution is unsafe or has not worked.</p>
        <a class="font-bold text-blue-dark underline underline-offset-3" href="/documents/ttn-complaints-policy.pdf" target="_blank" rel="noopener noreferrer">Read our complaints policy (PDF)<span class="sr-only"> (opens in a new tab)</span></a>
      </section>

      <aside id="form-notice" class="mb-8 rounded-lg border border-soft-blue bg-pale-blue p-5">
        <p class="mt-0 mb-1 font-bold">Online submissions are not available yet</p>
        <p class="m-0">You can look through the form below, but your details and files will not be sent or saved. Please use the contact guidance in the policy to raise a complaint now.</p>
      </aside>

      <form id="complaint-form" method="post" aria-labelledby="form-heading" aria-describedby="form-notice" class="rounded-xl border border-soft-blue bg-white p-[clamp(1.25rem,4vw,2.5rem)]">
        <header class="mb-8">
          <h2 id="form-heading" class="mt-0 mb-3 text-section font-bold">Submit a complaint</h2>
          <p class="mt-0 mb-3 text-body">Please provide as much detail as you can to help us understand your concern.</p>
          <p class="m-0 text-sm text-muted">Fields marked <span class="text-[#b42318]">*</span> are required.</p>
        </header>

        <fieldset class="mb-8 min-w-0 border-0 p-0">
          <legend class="mb-6 text-xl font-bold">Your details</legend>
          <div class="grid grid-cols-2 gap-x-6 max-[600px]:grid-cols-1">
            <div class="mb-6 min-w-0 border-0 p-0">
              <label class="mb-2 block font-bold" for="first-name">First name <span class="text-[#b42318]" aria-hidden="true">*</span></label>
              <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="first-name" name="firstName" autocomplete="given-name" required />
            </div>
            <div class="mb-6 min-w-0 border-0 p-0">
              <label class="mb-2 block font-bold" for="last-name">Last name <span class="text-[#b42318]" aria-hidden="true">*</span></label>
              <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="last-name" name="lastName" autocomplete="family-name" required />
            </div>
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="email">Email address <span class="text-[#b42318]" aria-hidden="true">*</span></label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="phone">Phone number <span class="font-normal text-muted">(optional)</span></label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <fieldset class="mb-6 min-w-0 border-0 p-0">
            <legend class="mb-2 block font-bold">Are you making this complaint on behalf of someone else? <span class="text-[#b42318]" aria-hidden="true">*</span></legend>
            <div class="flex flex-wrap gap-x-8 gap-y-2">
              <label class="flex min-h-11 cursor-pointer items-center gap-[.65rem]"><input class="size-[1.2rem] shrink-0 accent-blue-dark focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" type="radio" name="onBehalf" value="yes" required /> Yes</label>
              <label class="flex min-h-11 cursor-pointer items-center gap-[.65rem]"><input class="size-[1.2rem] shrink-0 accent-blue-dark focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" type="radio" name="onBehalf" value="no" required /> No</label>
            </div>
          </fieldset>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="represented-person">If yes, their name and your relationship to them</label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="represented-person" name="representedPerson" />
          </div>
        </fieldset>

        <fieldset class="mb-8 min-w-0 border-0 p-0">
          <legend class="mb-6 text-xl font-bold">About the incident</legend>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="incident-date">Date of incident <span class="text-[#b42318]" aria-hidden="true">*</span></label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="incident-date" name="incidentDate" type="date" required />
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="incident-location">Location of incident <span class="text-[#b42318]" aria-hidden="true">*</span></label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="incident-location" name="incidentLocation" required />
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="individuals">Names of individuals involved <span class="font-normal text-muted">(if known)</span></label>
            <input class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="individuals" name="individuals" />
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="incident-details">Please describe the incident in detail <span class="text-[#b42318]" aria-hidden="true">*</span></label>
            <p id="incident-help" class="mt-0 mb-2 text-[.9rem] text-muted">Tell us what happened, who was involved and any other information you think is relevant.</p>
            <textarea class="resize-y block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="incident-details" name="incidentDetails" rows="7" aria-describedby="incident-help" required></textarea>
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="category">Please select the category that best describes your complaint <span class="text-[#b42318]" aria-hidden="true">*</span></label>
            <select class="block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="category" name="category" required>
              <option value="">Please Select</option>
              <option>Player Conduct</option>
              <option>Official/Umpire Conduct</option>
              <option>Coach Conduct</option>
              <option>Spectator Conduct</option>
              <option>Club/Association Issue</option>
              <option>Other</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="mb-8 min-w-0 border-0 p-0">
          <legend class="mb-6 text-xl font-bold">Additional information</legend>
          <fieldset class="mb-6 min-w-0 border-0 p-0">
            <legend class="mb-2 block font-bold">Have you reported this complaint to anyone else? <span class="text-[#b42318]" aria-hidden="true">*</span></legend>
            <div class="flex flex-wrap gap-x-8 gap-y-2">
              <label class="flex min-h-11 cursor-pointer items-center gap-[.65rem]"><input class="size-[1.2rem] shrink-0 accent-blue-dark focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" type="radio" name="reportedElsewhere" value="yes" required /> Yes</label>
              <label class="flex min-h-11 cursor-pointer items-center gap-[.65rem]"><input class="size-[1.2rem] shrink-0 accent-blue-dark focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" type="radio" name="reportedElsewhere" value="no" required /> No</label>
            </div>
          </fieldset>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="earlier-report">If yes, who did you report it to and what happened?</label>
            <textarea class="resize-y block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="earlier-report" name="earlierReport" rows="3"></textarea>
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="outcome">What outcome would you like? <span class="font-normal text-muted">(optional)</span></label>
            <textarea class="resize-y block min-h-12 w-full min-w-0 rounded-md border border-muted bg-white px-[.8rem] py-[.65rem] text-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="outcome" name="desiredOutcome" rows="3"></textarea>
          </div>
          <div class="mb-6 min-w-0 border-0 p-0">
            <label class="mb-2 block font-bold" for="evidence">Supporting documents or evidence <span class="font-normal text-muted">(optional)</span></label>
            <div class="rounded-lg border border-dashed border-[#8c9dae] bg-white p-5">
              <input class="block w-full min-w-0 text-[.95rem] text-muted file:mr-4 file:min-h-11 file:cursor-pointer file:rounded-md file:border file:border-blue-dark file:bg-blue-dark file:px-4 file:py-[.65rem] file:font-bold file:text-white hover:file:border-navy hover:file:bg-navy focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue" id="evidence" name="evidence" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" multiple />
            </div>
          </div>
        </fieldset>

        <div class="border-t border-soft-blue pt-6">
          <label class="flex min-h-11 cursor-pointer items-start gap-[.65rem]" for="declaration">
            <input class="size-[1.2rem] shrink-0 accent-blue-dark focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue mt-[.2rem]" id="declaration" name="declaration" type="checkbox" required />
            <span>I confirm that the information provided in this complaint is true and accurate to the best of my knowledge. <span class="text-[#b42318]" aria-hidden="true">*</span></span>
          </label>
          <button type="submit" disabled aria-describedby="submission-help" class="mt-6 min-h-12 w-full cursor-not-allowed rounded-md bg-soft-blue px-6 py-3 font-bold text-muted sm:w-auto">Submit complaint</button>
          <p id="submission-help" class="mt-3 mb-0 text-sm text-muted">Sending is not enabled yet. No complaint will be submitted.</p>
        </div>
      </form>

      <section id="complaint-confirmation" aria-labelledby="confirmation-heading" class="rounded-xl border border-soft-blue bg-white p-[clamp(1.25rem,4vw,2.5rem)]" hidden>
        <h2 id="confirmation-heading" tabindex="-1" class="mt-0 mb-4 text-section font-bold">Your complaint has been sent</h2>
        <p class="mt-0 mb-6 text-body">Thank you for contacting Table Tennis Nelson. We’ve received your complaint and will be in touch.</p>
        <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-md bg-blue px-5 py-3 font-medium text-white no-underline hover:bg-blue-dark">Return to the home page</a>
      </section>
    </div>
  </Container>
</SiteLayout>

<script>
  // Keep this preview local until complaint delivery is connected.
  const form = document.getElementById('complaint-form')!;
  form.addEventListener('submit', event => event.preventDefault());

  if (import.meta.env.DEV && new URLSearchParams(location.search).get('preview') === 'sent') {
    form.hidden = true;
    document.getElementById('form-notice')!.hidden = true;
    document.getElementById('complaint-confirmation')!.hidden = false;
    document.getElementById('confirmation-heading')!.focus();
  }
</script>

