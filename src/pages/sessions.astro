---
import SiteLayout from '../layouts/SiteLayout.astro';

const weekdays = [
  ['Monday', 'monday'], ['Tuesday', 'tuesday'], ['Wednesday', 'wednesday'],
  ['Thursday', 'thursday'], ['Friday', 'friday'],
  ['Saturday', 'saturday'], ['Sunday', 'sunday'],
] as const;
---

<SiteLayout title="Weekly Programme | Table Tennis Nelson" description="Weekly table tennis sessions at Table Tennis Nelson.">
  <section class="programme" aria-labelledby="programme-title">
    <div class="wrap">
      <h1 id="programme-title">Sessions</h1>
      <p id="session-status" role="status">Loading sessions…</p>

      <div class="day-grid" hidden>
        {weekdays.map(([name, key]) => (
          <article class="day-card" data-day={key}>
            <div class="card-heading"><h2>{name}</h2></div>

            <ul class="preview"></ul>
            <details>
              <summary>
                <span class="show-label">More info<span class="sr-only"> about {name}</span></span>
                <span class="hide-label">Less info<span class="sr-only"> about {name}</span></span>
                <span class="toggle-icon" aria-hidden="true"></span>
              </summary>
              <div class="details"></div>
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  type Session = {
    title: string;
    time: string;
    description: string;
    schoolTermsOnly?: boolean;
    highlights?: string | null;
    contactEmail?: string | null;
  };

  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const cards = [...document.querySelectorAll<HTMLElement>('.day-card[data-day]')];

  function addText(parent: HTMLElement, tag: 'span' | 'h3' | 'p' | 'li', className: string, value: string) {
    const child = document.createElement(tag);
    child.className = className;
    child.textContent = value;
    parent.append(child);
  }

  function renderDay(card: HTMLElement, sessions: Session[]) {
    const preview = card.querySelector('.preview');
    const details = card.querySelector('.details');
    if (!preview || !details) return;

    const previewRows = sessions.map((session) => {
      const row = document.createElement('li');
      addText(row, 'span', 'time', session.time);
      addText(row, 'span', 'name', session.title);
      if (session.schoolTermsOnly) addText(row, 'span', 'term-note', 'School Terms Only');
      return row;
    });

    if (previewRows.length === 0) {
      const empty = document.createElement('li');
      empty.textContent = 'No sessions listed';
      previewRows.push(empty);
    }
    preview.replaceChildren(...previewRows);

    const sections = sessions.map((session) => {
      const section = document.createElement('section');
      section.className = 'session-detail';
      addText(section, 'h3', '', session.title);
      addText(section, 'p', '', session.description);

      const highlights = session.highlights?.split(/\r?\n/).map((item) => item.trim()).filter(Boolean) ?? [];
      if (highlights.length > 0) {
        const list = document.createElement('ul');
        highlights.forEach((item) => addText(list, 'li', '', item));
        section.append(list);
      }

      if (session.contactEmail) {
        const contact = document.createElement('p');
        contact.className = 'contact';
        contact.append('For more information, email: ');
        const link = document.createElement('a');
        link.href = `mailto:${session.contactEmail}`;
        link.textContent = session.contactEmail;
        contact.append(link);
        section.append(contact);
      }
      return section;
    });

    details.replaceChildren(...sections);
    card.querySelector('details')?.toggleAttribute('hidden', sessions.length === 0);
  }

  const status = document.querySelector<HTMLElement>('#session-status');

  if (!cmsUrl) {
    if (status) status.textContent = 'Sessions are unavailable right now. Please try again later.';
  } else {
    const url = new URL('/api/session-schedule?populate=*', cmsUrl);
    fetch(url, { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
        return response.json();
      })
      .then(({ data }) => {
        if (!data || !cards.every((card) => Array.isArray(data[card.dataset.day!]))) {
          throw new Error('Strapi returned an incomplete schedule');
        }
        document.querySelector('#programme-title')!.textContent = data.heading;
        document.title = `${data.heading} | Table Tennis Nelson`;
        cards.forEach((card) => renderDay(card, data[card.dataset.day!]));
        document.querySelector('.day-grid')?.removeAttribute('hidden');
        if (status) status.hidden = true;
      })
      .catch((error) => {
        if (status) status.textContent = 'Sessions are unavailable right now. Please try again later.';
        console.warn('Could not load sessions from Strapi:', error);
      });
  }
</script>

<style>
  .programme {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--pale-blue);
  }

  .wrap {
    width: min(100% - 3rem, 1200px);
    margin-inline: auto;
  }

  h1, h2, .details :global(h3), .details :global(p) {
    margin-top: 0;
  }

  h1, h2, .details :global(h3) {
    line-height: 1.1;
    letter-spacing: -.04em;
  }

  h1 {
    margin-bottom: 2.5rem;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
  }

  .day-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .day-grid[hidden] {
    display: none;
  }

  .day-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1.5px solid var(--blue);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(23, 59, 104, .13);
  }

  .card-heading {
    padding: 1.3rem 1.5rem;
    color: var(--navy);
  }

  h2 {
    margin-bottom: 0;
    font-size: 1.8rem;
  }

  .preview {
    margin: 0;
    padding: .45rem 1.5rem;
    list-style: none;
  }

  .preview :global(li) {
    display: grid;
    grid-template-columns: 7.2rem minmax(0, 1fr);
    gap: .25rem .8rem;
    padding-block: .9rem;
  }

  .preview :global(li + li) {
    border-top: 1px solid var(--soft-blue);
  }

  .preview :global(.time) {
    color: var(--blue-dark);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }

  .preview :global(.name) {
    font-size: 1.03rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .preview :global(.term-note) {
    grid-column: 2;
    color: var(--muted);
    font-size: .88rem;
  }

  details {
    margin-top: auto;
    border-top: 1px solid var(--soft-blue);
  }

  summary {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding-inline: 1.5rem;
    color: var(--blue-dark);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .hide-label, details[open] .show-label {
    display: none;
  }

  details[open] .hide-label {
    display: inline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .toggle-icon {
    position: relative;
    width: 24px;
    height: 24px;
  }

  .toggle-icon::before, .toggle-icon::after {
    content: '';
    position: absolute;
    top: 11px;
    left: 4px;
    width: 16px;
    height: 2px;
    background: var(--blue-dark);
  }

  .toggle-icon::after {
    transform: rotate(90deg);
  }

  details[open] .toggle-icon::after {
    display: none;
  }

  summary:hover .toggle-icon::before, summary:hover .toggle-icon::after {
    background: var(--blue-dark);
  }

  summary:focus-visible {
    outline: none;
  }

  summary:focus-visible .toggle-icon {
    outline: 3px solid var(--navy);
    outline-offset: 3px;
  }

  .details {
    padding: 0 1.5rem 1.2rem;
  }

  .details :global(.session-detail + .session-detail) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--soft-blue);
  }

  .details :global(h3) {
    margin-bottom: .4rem;
    font-size: 1.1rem;
  }

  .details :global(.session-detail p) {
    margin-bottom: 0;
  }

  .details :global(.session-detail ul) {
    margin: .7rem 0 0;
    padding-left: 1.25rem;
  }

  .details :global(.session-detail li + li) {
    margin-top: .25rem;
  }

  .details :global(.contact) {
    margin-top: .8rem;
  }

  .details :global(.contact a) {
    color: var(--blue-dark);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (max-width: 950px) {
    .day-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .programme {
      padding-block: 2.5rem;
    }

    .wrap {
      width: min(100% - 2rem, 1200px);
    }

    h1 {
      margin-bottom: 2rem;
    }

    .day-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card-heading {
      padding: 1.2rem;
    }

    .preview {
      padding-inline: 1.2rem;
    }

    summary {
      padding-inline: 1.2rem;
    }

    .details {
      padding-inline: 1.2rem;
    }
  }

  @media (max-width: 360px) {
    .preview :global(li) {
      grid-template-columns: 1fr;
    }

    .preview :global(.term-note) {
      grid-column: 1;
    }
  }
</style>
