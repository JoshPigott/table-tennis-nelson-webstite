---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getImage } from 'astro:assets';
import playPhoto from '../assets/home/table-tennis-nelson-action.webp';
import socialPhoto from '../assets/home/table-tennis-women-playing.webp';
import juniorPhoto from '../assets/coaching/junior-group.webp';
import parkinsonsPhoto from '../assets/ping-pong-parkinsons/players-at-table.png';
import competitionPhoto from '../assets/sessions/thursday-competition.png';
import wednesdayPhoto from '../assets/sessions/wednesday-morning.png';
import paraPhoto from '../assets/sessions/para-power.png';
import morningPhoto from '../assets/sessions/morning-social.jpg';

const sessionPhotos = await Promise.all([playPhoto, socialPhoto, juniorPhoto, parkinsonsPhoto, competitionPhoto, wednesdayPhoto, paraPhoto, morningPhoto].map(
  (src) => getImage({
    src,
    // Keep enough pixels for a 150 × 105 thumbnail on high-density screens,
    // including wide photos whose sides are cropped by object-fit: cover.
    width: Math.min(src.width, Math.ceil(Math.max(450, 315 * src.width / src.height))),
    format: 'webp',
    quality: 90,
  })
));

const weekdays = [
  ['Monday', 'monday'], ['Tuesday', 'tuesday'], ['Wednesday', 'wednesday'],
  ['Thursday', 'thursday'], ['Friday', 'friday'],
  ['Saturday', 'saturday'], ['Sunday', 'sunday'],
] as const;
import Container from '../components/Container.astro';
import FeeList from '../components/FeeList.astro';
import SessionCardTemplate from '../components/SessionCardTemplate.astro';
---

<SiteLayout title="Sessions & Fees | Table Tennis Nelson" description="See weekly table tennis sessions and playing fees at Table Tennis Nelson.">
  <section class="bg-pale-blue py-[clamp(3rem,6vw,5rem)] max-[600px]:py-10" aria-labelledby="programme-title">
    <Container>
      <h1 id="programme-title" class="mt-0 mb-10 text-[clamp(3rem,6vw,5rem)] font-bold leading-[1.1] tracking-[-.04em] max-[600px]:mb-8">Sessions</h1>
      <p id="session-status" role="status" class="my-4">Loading sessions…</p>
      <div id="day-list" hidden data-photos={JSON.stringify(sessionPhotos.map((photo) => photo.src))}>
        {weekdays.map(([name, key]) => (
          <section class="mb-10 last:mb-0 max-[700px]:mb-8" data-day={key} aria-labelledby={'day-' + key}>
            <header class="sticky top-0 z-2 flex items-center justify-between gap-4 border-b border-[#e4e5e7] bg-[#f7f7f7] px-6 py-[1.2rem] max-[700px]:px-0 max-[700px]:py-4">
              <h2 id={'day-' + key} class="m-0 text-[1.8rem] font-bold leading-[1.1] tracking-[-.04em] max-[700px]:text-2xl">{name}</h2>
              <span data-day-count class="text-[.85rem] whitespace-nowrap text-muted"></span>
            </header>
            <div data-session-list class="pt-2 max-[700px]:grid max-[700px]:gap-4 max-[700px]:pt-4"></div>
          </section>
        ))}
      </div>
      <SessionCardTemplate />
    </Container>
  </section>

  <section class="py-[clamp(3rem,6vw,5rem)]" aria-labelledby="fees-title">
    <Container size="medium">
      <h2 id="fees-title" class="mt-0 mb-10 text-[clamp(2.7rem,5vw,4rem)] font-bold leading-[1.1] tracking-[-.04em] max-[600px]:mb-6">Fees</h2>
      <p id="fees-status" role="status" class="my-4">Loading fees…</p>
      <div id="fee-layout" class="grid grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] gap-[clamp(2rem,5vw,5rem)] max-[700px]:grid-cols-1 max-[700px]:gap-8" hidden>
        <div class="grid content-start gap-8 [&>div+div]:border-t [&>div+div]:border-soft-blue [&>div+div]:pt-6 max-[700px]:contents">
          <div>
            <h3 class="m-0 text-[1.3rem] font-bold leading-[1.25]">Casual play</h3>
            <p class="mt-2 mb-0 text-muted"><strong id="casual-price" class="text-[clamp(2.7rem,5vw,3.8rem)] font-bold leading-none text-blue-dark"></strong> <span id="casual-unit"></span></p>
          </div>
          <div class="max-[700px]:row-start-3">
            <h3 class="m-0 text-[1.3rem] font-bold leading-[1.25]">Bank transfer</h3>
            <dl class="mt-[.8rem] mb-0 grid gap-3 [&_dt]:text-[.9rem] [&_dt]:text-muted [&_dd]:mt-[.2rem] [&_dd]:font-bold [&_dd]:tabular-nums [&_dd]:[overflow-wrap:anywhere]">
              <div><dt>Account name</dt><dd id="bank-name"></dd></div>
              <div><dt>Account number</dt><dd id="bank-number"></dd></div>
            </dl>
          </div>
        </div>
        <div class="border-l border-soft-blue pl-[clamp(2rem,4vw,4rem)] max-[700px]:border-t max-[700px]:border-l-0 max-[700px]:pt-6 max-[700px]:pl-0">
          <h3 class="mt-0 mb-[.8rem] text-[1.3rem] font-bold leading-[1.25]">Term fees <small id="term-length" class="ml-2 text-[.9rem] font-normal text-muted max-[600px]:mt-[.35rem] max-[600px]:ml-0 max-[600px]:block"></small></h3>
          <FeeList id="term-fee-list" />
          <h3 class="mt-6 mb-[.8rem] text-[1.3rem] font-bold leading-[1.25]">Annual membership</h3>
          <FeeList id="annual-fee-list" annual />
        </div>
      </div>
    </Container>
  </section>
</SiteLayout>

<script>
  type Session = {
    title: string;
    time: string;
    description: string;
    schoolTermsOnly?: boolean;
    highlights?: string | null;
    contactEmail?: string | null;
  };

  type FeeItem = { label: string; price: string };
  type Fees = {
    annualFees: FeeItem[];
    termFees: FeeItem[];
    termLength: string;
    bankAccountName: string;
    bankAccountNumber: string;
    casualPrice: string;
    casualUnit: string;
  };

  const localSite = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const cmsUrl = import.meta.env.PUBLIC_STRAPI_URL || (localSite ? 'http://localhost:1337' : '');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-day]')];
  const photos: string[] = JSON.parse(document.getElementById('day-list')!.dataset.photos!);
  const cardTemplate = document.getElementById('session-card-template') as HTMLTemplateElement;
  const timeTemplate = document.getElementById('session-time-template') as HTMLTemplateElement;
  const separatorTemplate = document.getElementById('session-separator-template') as HTMLTemplateElement;
  const singleTimeTemplate = document.getElementById('session-single-time-template') as HTMLTemplateElement;

  function renderDay(card: HTMLElement, sessions: Session[]) {
    const list = card.querySelector('[data-session-list]');
    if (!list) return;
    const count = card.querySelector('[data-day-count]');
    if (count) count.textContent = `${sessions.length} ${sessions.length === 1 ? 'session' : 'sessions'}`;

    const sections = sessions.map((session) => {
      const fragment = cardTemplate.content.cloneNode(true) as DocumentFragment;
      const row = fragment.querySelector('article')!;
      const day = card.dataset.day;
      const morning = /morning/i.test(session.title);
      let photoIndex = /parkinson/i.test(session.title) ? 3 : /junior|coaching/i.test(session.title) ? 2 : /social/i.test(session.title) ? 1 : 0;
      if (day === 'thursday' && /competitive|competition/i.test(session.title)) photoIndex = 4;
      if (day === 'wednesday' && morning) photoIndex = 5;
      if (/para\s*power/i.test(session.title)) photoIndex = 6;
      if ((day === 'monday' || day === 'friday') && morning) photoIndex = 7;
      const image = row.querySelector<HTMLImageElement>('[data-photo]')!;
      image.src = photos[photoIndex];
      image.classList.toggle('object-[center_35%]', photoIndex === 4 || photoIndex === 6);
      row.querySelector('[data-note]')!.textContent = session.schoolTermsOnly ? 'School terms only' : 'Weekly session';
      row.querySelector('[data-title]')!.textContent = session.title;
      row.querySelector('[data-description]')!.textContent = session.description;

      const highlights = session.highlights?.split(/\r?\n/).map((item) => item.trim()).filter(Boolean) ?? [];
      const highlightsList = row.querySelector<HTMLUListElement>('[data-highlights]')!;
      highlightsList.hidden = highlights.length === 0;
      highlights.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        highlightsList.append(li);
      });
      if (session.contactEmail) {
        const contact = row.querySelector<HTMLParagraphElement>('[data-contact]')!;
        const link = contact.querySelector('a')!;
        link.href = `mailto:${session.contactEmail}`;
        link.textContent = session.contactEmail;
        contact.hidden = false;
      }
      const timing = row.querySelector<HTMLElement>('[data-timing]')!;
      const timeParts = session.time.split(/\s*[–—−-]\s*/);
      if (timeParts.length === 2) {
        timeParts.forEach((part, index) => {
          if (index > 0) timing.append(separatorTemplate.content.cloneNode(true));
          const fragment = timeTemplate.content.cloneNode(true) as DocumentFragment;
          const match = part.trim().match(/^(\d{1,2}(?::\d{2})?)\s*(am|pm)$/i);
          fragment.querySelector('[data-time]')!.textContent = match ? match[1] : part.trim();
          fragment.querySelector('[data-period]')!.textContent = match ? match[2].toLowerCase() : '';
          timing.append(fragment);
        });
      } else {
        const fragment = singleTimeTemplate.content.cloneNode(true) as DocumentFragment;
        fragment.firstElementChild!.textContent = session.time;
        timing.append(fragment);
      }
      timing.setAttribute('aria-label', `Session time: ${session.time}`);
      return row;
    });
    if (sections.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'm-0 p-6 text-muted';
      empty.textContent = 'No sessions listed';
      list.replaceChildren(empty);
    } else {
      list.replaceChildren(...sections);
    }
  }

  const status = document.querySelector<HTMLElement>('#session-status');

  if (!cmsUrl) {
    if (status) status.textContent = 'Sessions are unavailable right now. Please try again later.';
  } else {
    const url = new URL('/api/session-schedule?populate=*', cmsUrl);
    fetch(url, { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
        return response.json();
      })
      .then(({ data }) => {
        if (!data || !cards.every((card) => Array.isArray(data[card.dataset.day!]))) {
          throw new Error('Strapi returned an incomplete schedule');
        }
        document.querySelector('#programme-title')!.textContent = data.heading;
        cards.forEach((card) => renderDay(card, data[card.dataset.day!]));
        document.querySelector('#day-list')?.removeAttribute('hidden');
        if (status) status.hidden = true;
      })
      .catch((error) => {
        if (status) status.textContent = 'Sessions are unavailable right now. Please try again later.';
        console.warn('Could not load sessions from Strapi:', error);
      });
  }

  const feesStatus = document.querySelector<HTMLElement>('#fees-status');

  function renderFeeList(id: string, items: FeeItem[]) {
    const rows = items.map(({ label, price }) => {
      const row = document.createElement('div');
      const name = document.createElement('dt');
      const amount = document.createElement('dd');
      name.textContent = label;
      amount.textContent = price;
      row.append(name, amount);
      return row;
    });
    document.getElementById(id)?.replaceChildren(...rows);
  }

  function renderFees(data: Fees) {
    const filled = (value: unknown) => typeof value === 'string' && value.trim().length > 0;
    const validItems = (items: unknown): items is FeeItem[] =>
      Array.isArray(items) && items.length > 0 && items.every((item) => filled(item?.label) && filled(item?.price));

    if (!data || !validItems(data.annualFees) || !validItems(data.termFees) ||
      ![data.termLength, data.bankAccountName, data.bankAccountNumber, data.casualPrice, data.casualUnit].every(filled)) {
      throw new Error('Strapi returned incomplete fees');
    }

    renderFeeList('annual-fee-list', data.annualFees);
    renderFeeList('term-fee-list', data.termFees);
    document.getElementById('term-length')!.textContent = data.termLength;
    document.getElementById('bank-name')!.textContent = data.bankAccountName;
    document.getElementById('bank-number')!.textContent = data.bankAccountNumber;
    document.getElementById('casual-price')!.textContent = data.casualPrice;
    document.getElementById('casual-unit')!.textContent = data.casualUnit;
    document.querySelector('#fee-layout')?.removeAttribute('hidden');
    if (feesStatus) feesStatus.hidden = true;
  }

  if (!cmsUrl) {
    if (feesStatus) feesStatus.textContent = 'Fees are unavailable right now. Please try again later.';
  } else {
    fetch(new URL('/api/fee-schedule?populate=*', cmsUrl), { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error(`Strapi returned ${response.status}`);
        return response.json();
      })
      .then(({ data }) => renderFees(data))
      .catch((error) => {
        if (feesStatus) feesStatus.textContent = 'Fees are unavailable right now. Please try again later.';
        console.warn('Could not load fees from Strapi:', error);
      });
  }
</script>
