---
import '../styles/global.css';
import Container from '../components/Container.astro';

interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const facebook = 'https://www.facebook.com/TableTennisNelsonPage/';
const navigation = [
  ['/sessions/', 'Sessions & fees'],
  ['/draws/', 'Draws'],
  ['/coaching/', 'Coaching'],
  ['/para-power/', 'Para Power'],
  ['/ping-pong-parkinsons/', 'Ping Pong Parkinson’s'],
];
const footerLinks = [
  ['/code-of-conduct/', 'Code of conduct'],
  ['/strategic-plan/', 'Strategic plan'],
  ['mailto:tabletennisnelson@outlook.com', 'Email us'],
];
---

<!doctype html>
<html lang="en-NZ" class="scroll-smooth [scrollbar-gutter:stable] motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="m-0 flex min-h-screen flex-col bg-paper font-sans leading-[1.55] text-navy [&_a:focus-visible]:outline-[3px] [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-blue-dark [&_button:focus-visible]:outline-[3px] [&_button:focus-visible]:outline-offset-4 [&_button:focus-visible]:outline-blue-dark">
    <header class="border-b border-soft-blue bg-paper">
      <Container class="flex min-h-[84px] items-center justify-between gap-8 max-[780px]:min-h-[68px] max-[600px]:min-h-16 max-[600px]:flex-wrap max-[600px]:gap-[.4rem] max-[600px]:py-[.65rem] max-[380px]:gap-2">
        <a class="flex items-center gap-[.3rem] text-[1.1rem] font-semibold tracking-[-.04em] whitespace-nowrap no-underline max-[600px]:text-[1.13rem] max-[380px]:text-[.95rem]" href="/" aria-label="Table Tennis Nelson home">Table Tennis <strong class="font-semibold">Nelson</strong></a>
        <nav aria-label="Main navigation" class="flex flex-wrap gap-2 max-[600px]:w-full">
          {navigation.map(([href, label]) => (
            <a {href} class="inline-flex min-h-10 items-center rounded-md border border-blue px-[.9rem] py-[.4rem] text-[.9rem] font-bold text-blue-dark no-underline hover:bg-pale-blue max-[380px]:px-[.65rem]">{label}</a>
          ))}
        </nav>
      </Container>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="bg-navy text-white">
      <Container class="flex min-h-[98px] items-center justify-between gap-8 text-[.85rem] max-[600px]:flex-col max-[600px]:items-start max-[600px]:justify-center max-[600px]:gap-[.8rem] max-[600px]:py-6">
        <span>© {new Date().getFullYear()} Table Tennis Nelson</span>
        <div class="flex flex-wrap gap-[clamp(1rem,3vw,2.5rem)] [&_a]:text-[.92rem] [&_a]:font-bold [&_a]:no-underline [&_a:hover]:text-soft-blue max-[600px]:gap-x-6 max-[600px]:gap-y-3">
          {footerLinks.map(([href, label]) => <a {href}>{label}</a>)}
          <a href={facebook} target="_blank" rel="noopener noreferrer">Find us on Facebook <span aria-hidden="true">↗</span></a>
        </div>
      </Container>
    </footer>
  </body>
</html>
