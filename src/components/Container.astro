---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'section' | 'article' | 'p';
  size?: 'wide' | 'medium' | 'reading';
  mobileAt?: '600' | '650';
};

const { as: Tag = 'div', size = 'wide', mobileAt = '600', class: className, ...attributes } = Astro.props;
const widths = { wide: 'max-w-[1200px]', medium: 'max-w-[1100px]', reading: 'max-w-[1000px]' };
const mobileWidths = { '600': 'max-[600px]:w-[calc(100%_-_2.5rem)]', '650': 'max-[650px]:w-[calc(100%_-_2.5rem)]' };
---

<Tag class:list={['mx-auto w-[calc(100%_-_3rem)]', widths[size], mobileWidths[mobileAt], className]} {...attributes}><slot /></Tag>
