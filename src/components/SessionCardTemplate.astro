---
import SessionTimeValue from './SessionTimeValue.astro';
---

<!-- Cloned by the schedule loader; all card and time styles live here. -->
<template id="session-card-template">
  <article class="relative grid grid-cols-[150px_minmax(0,1fr)_190px] items-start gap-11 rounded-[9px] bg-[#f7f7f7] px-6 py-8 after:absolute after:right-6 after:bottom-0 after:left-6 after:h-px after:bg-[#e6e7e9] after:content-[''] max-[950px]:grid-cols-[120px_minmax(0,1fr)_165px] max-[950px]:gap-6 max-[700px]:grid-cols-[minmax(0,1fr)] max-[700px]:gap-x-4 max-[700px]:gap-y-5 max-[700px]:rounded-xl max-[700px]:border max-[700px]:border-soft-blue max-[700px]:bg-white max-[700px]:p-5 max-[700px]:shadow-[0_3px_12px_rgb(23_59_104_/_0.04)] max-[700px]:[grid-template-areas:'photo'_'title'_'time'_'note'_'description'] max-[700px]:after:hidden max-[420px]:gap-4 max-[420px]:p-4">
    <div class="relative h-[105px] w-[150px] overflow-hidden rounded-[7px] max-[950px]:h-[90px] max-[950px]:w-[120px] max-[700px]:aspect-video max-[700px]:h-auto max-[700px]:w-full max-[700px]:rounded-lg max-[700px]:[grid-area:photo]">
      <img data-photo class="block h-full w-full object-cover" alt="" width="150" height="105" loading="lazy" />
    </div>
    <div class="min-w-0 max-[700px]:contents">
      <span data-note class="mb-3 inline-flex items-center rounded-full bg-[#e6e7e9] px-2.5 py-0.5 text-[.85rem] font-bold leading-normal text-blue-dark max-[700px]:m-0 max-[700px]:justify-self-start max-[700px]:bg-pale-blue max-[700px]:[grid-area:note]"></span>
      <h3 data-title class="mt-0 mb-3 text-xl font-bold leading-[1.15] tracking-[-.04em] text-navy max-[700px]:m-0 max-[700px]:leading-[1.3] max-[700px]:[grid-area:title]"></h3>
      <p data-description class="m-0 max-w-[560px] text-[1.1rem] leading-[1.65] text-muted max-[700px]:text-base max-[700px]:leading-[1.6] max-[700px]:[grid-area:description]"></p>
      <ul data-highlights hidden class="mt-3 mb-0 list-disc pl-[1.2rem] text-base text-muted [&_li+li]:mt-[.3rem]"></ul>
      <p data-contact hidden class="mt-3 mb-0 text-base text-muted max-[700px]:border-t max-[700px]:border-soft-blue max-[700px]:pt-[.85rem] max-[700px]:text-[.95rem]">For more information, email: <a class="font-bold text-blue-dark underline underline-offset-3 [overflow-wrap:anywhere]"></a></p>
    </div>
    <div data-timing class="flex justify-center gap-[9px] pt-5 text-blue-dark max-[700px]:min-w-0 max-[700px]:flex-wrap max-[700px]:items-baseline max-[700px]:justify-start max-[700px]:gap-[.35rem] max-[700px]:self-center max-[700px]:p-0 max-[700px]:[grid-area:time]"></div>
  </article>
</template>

<template id="session-time-template">
  <div class="text-center max-[700px]:flex max-[700px]:items-baseline max-[700px]:gap-[.2rem]">
    <SessionTimeValue data-time />
    <span data-period class="mt-[5px] block text-base max-[700px]:m-0 max-[700px]:text-[.85rem]"></span>
  </div>
</template>

<template id="session-separator-template">
  <SessionTimeValue>–</SessionTimeValue>
</template>

<template id="session-single-time-template">
  <SessionTimeValue as="p" />
</template>
